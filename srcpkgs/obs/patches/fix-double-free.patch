+void add_default_module_paths(void)
+{
+	/* Only the install-time paths are used: the "../" paths derived from
+	 * the executable location duplicate the install prefix on several
+	 * packages and were a double free (obs-studio#11029). */
+	const char *module_bin[] = {
+		OBS_INSTALL_PREFIX "/" OBS_PLUGIN_DESTINATION,
+	};
+	const char *module_data[] = {
+		OBS_INSTALL_DATA_PATH "/obs-plugins/%module%",
+	};
+	const int module_patterns_size =
+		sizeof(module_bin) / sizeof(module_bin[0]);
+
+	for (int i = 0; i < module_patterns_size; i++) {
+		obs_add_module_path(module_bin[i], module_data[i]);
+	}
+}
