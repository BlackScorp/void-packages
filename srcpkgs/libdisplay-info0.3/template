# Template file for 'libdisplay-info0.3'
pkgname=libdisplay-info0.3
version=0.3.0
revision=1
wrksrc="libdisplay-info-${version}"
build_style=meson
hostmakedepends="hwids"
short_desc="EDID and DisplayID library (0.3 series)"
maintainer="BlackScorp <cccpmik@gmail.com>"
license="MIT"
homepage="https://gitlab.freedesktop.org/emersion/libdisplay-info/"
distfiles="${homepage}-/archive/${version}/libdisplay-info-${version}.tar.gz"
checksum=2b467e3336aec63819d6aca28d7310d3dc7415b2b3a3c3a5aec9d3727053c078
make_check=no

post_install() {
	# The utility keeps its unversioned name and conflicts with the 0.2 package.
	rm -rf "${DESTDIR}/usr/bin"
	vlicense LICENSE
}

libdisplay-info0.3-devel_package() {
	depends="${sourcepkg}>=${version}_${revision}"
	pkg_install() {
		vmove usr/include
		vmove "usr/lib/*.so"
		vmove usr/lib/pkgconfig
	}
}
